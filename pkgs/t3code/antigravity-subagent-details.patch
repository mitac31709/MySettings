+const SYSTEM_IDLE_NOTICE =
+  /^Subagent ([\w-]+) has gone idle\.(?:\s*This was the subagent's most recent response:\s*([\s\S]*))?$/u;
+const SYSTEM_ERROR_NOTICE =
+  /^The subagent\b[\s\S]*?\bwith id "([\w-]+)" encountered an error[^:]*:\s*([\s\S]+)$/u;
+
+type ParentInboxNotice =
+  | { readonly kind: "reported"; readonly childId: string; readonly text: string }
+  | { readonly kind: "idle"; readonly childId: string; readonly text: string }
+  | { readonly kind: "error"; readonly childId: string; readonly text: string };
+
+function parseParentInboxNotice(message: ChildMessage): ParentInboxNotice | undefined {
+  if (message.sender !== "system") {
+    return NATIVE_ID.test(message.sender)
+      ? { kind: "reported", childId: message.sender, text: message.content?.trim() ?? "" }
+      : undefined;
+  }
+  const content = message.content?.trim() ?? "";
+  const errorMatch = SYSTEM_ERROR_NOTICE.exec(content);
+  if (errorMatch?.[1] !== undefined && NATIVE_ID.test(errorMatch[1])) {
+    return { kind: "error", childId: errorMatch[1], text: errorMatch[2]?.trim() ?? content };
+  }
+  const idleMatch = SYSTEM_IDLE_NOTICE.exec(content);
+  if (idleMatch?.[1] !== undefined && NATIVE_ID.test(idleMatch[1])) {
+    return { kind: "idle", childId: idleMatch[1], text: idleMatch[2]?.trim() ?? "" };
+  }
+  return undefined;
+}
+
+function summarizeParentInbox(messages: ReadonlyArray<ChildMessage>) {
+  const reported = new Set<string>();
+  const byChild = new Map<string, ParentInboxChildSummary>();
+  for (const message of messages) {
+    const notice = parseParentInboxNotice(message);
+    if (notice === undefined) continue;
+    reported.add(notice.childId);
+    const current = byChild.get(notice.childId) ?? {};
+    if (notice.kind === "reported") {
+      byChild.set(notice.childId, { ...current, reportedText: notice.text });
+    } else if (notice.kind === "idle") {
+      byChild.set(notice.childId, { ...current, idleText: notice.text });
+    } else {
+      byChild.set(notice.childId, { ...current, errorText: notice.text });
+    }
+  }
+  return { reported, byChild };
+}
