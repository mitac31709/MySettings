+/** Reads a single subagent child's native transcript + status as V2 thread items for hydration. */
+export const readAntigravityChildTimeline = Effect.fn("readAntigravityChildTimeline")(
+  function* (input: {
+    readonly profileDirectory: string;
+    readonly rootSessionId: string;
+    readonly nativeTaskId: string;
+    readonly launch: BatchLaunch;
+    readonly siblings: ReadonlyArray<BatchLaunch & { readonly nativeTaskId: string }>;
+    readonly target: AntigravityChildTimelineInput;
+  }) {
+    if (!NATIVE_ID.test(input.rootSessionId)) return undefined;
+    return yield* Effect.tryPromise({
+      try: async (): Promise<AntigravityChildTimelineResult | undefined> => {
+        const profileRoot = await antigravityProfileRoot(input.profileDirectory);
+        if (profileRoot === undefined) return undefined;
+        let record = await findDetachedInvokeRecord(
+          profileRoot,
+          input.rootSessionId,
+          input.nativeTaskId,
+        );
+        const isDetached = record !== undefined;
+        if (record === undefined) {
+          const databasePath = (
+            await antigravityManagedPath(
+              profileRoot,
+              ["antigravity-acp", "conversations", `${input.rootSessionId}.db`],
+              "file",
+            )
+          )?.path;
+          if (databasePath === undefined) return undefined;
+          const database = new NodeSqlite.DatabaseSync(databasePath, { readOnly: true });
+          try {
+            record = findInvokeRecord(database, input);
+          } finally {
+            database.close();
+          }
+        }
+        if (record === undefined || record.children.length !== 1) return undefined;
+        const child = record.children[0]!;
+        const { byChild } = isDetached
+          ? summarizeParentInbox(await readInbox(profileRoot, input.rootSessionId).catch(() => []))
+          : { byChild: new Map<string, ParentInboxChildSummary>() };
+        const detachedRecord = isDetached
+          ? await readDetachedSubagent(profileRoot, input.rootSessionId, child.conversationId)
+          : undefined;
+        const transcript = await readRawTranscript(
+          profileRoot,
+          child,
+          TIMELINE_TRANSCRIPT_BYTE_CAP,
+        ).catch(() => undefined);
+        return buildAntigravityChildTimeline({
+          target: input.target,
+          rootSessionId: input.rootSessionId,
+          childConversationId: child.conversationId,
+          rawSteps: transcript?.rawSteps ?? [],
+          truncated: transcript?.truncated ?? false,
+          parentNotice: byChild.get(child.conversationId),
+          subagentState: detachedRecord?.state,
+        });
+      },
+      catch: (cause) => new AntigravityChildWorkReadError({ cause }),
+    });
+  },
+);
