+/**
+ * Syncs detached agy 1.5 child transcripts and parent inbox notices for live subagents of a session.
+ */
+export const readAntigravityDetachedSubagentSync = Effect.fn(
+  "readAntigravityDetachedSubagentSync",
+)(function* (input: {
+  readonly profileDirectory: string;
+  readonly rootSessionId: string;
+  readonly subagents: ReadonlyArray<AntigravityChildTimelineInput>;
+}) {
+  if (!NATIVE_ID.test(input.rootSessionId) || input.subagents.length === 0) return [];
+  const read = async (): Promise<ReadonlyArray<AntigravityDetachedSubagentSyncEntry>> => {
+    const profileRoot = await antigravityProfileRoot(input.profileDirectory);
+    if (profileRoot === undefined) return [];
+    const childIds = await listDetachedChildIds(profileRoot, input.rootSessionId);
+    if (childIds === undefined || childIds.length === 0) return [];
+    const targetsByTaskId = new Map(input.subagents.map((target) => [target.nativeTaskId, target]));
+    const { byChild: inboxByChild } = summarizeParentInbox(
+      await readInbox(profileRoot, input.rootSessionId).catch(() => []),
+    );
+    const claims = new Map<
+      string,
+      Array<{
+        readonly childId: string;
+        readonly state: string | undefined;
+      }>
+    >();
+    for (const childId of childIds) {
+      const messages = await readInbox(profileRoot, childId).catch(() => undefined);
+      if (messages === undefined) continue;
+      for (const message of messages) {
+        const launch = detachedLaunchCall(message, input.rootSessionId);
+        if (launch === undefined || !targetsByTaskId.has(launch.id)) continue;
+        const subagent = await readDetachedSubagent(profileRoot, input.rootSessionId, childId);
+        const list = claims.get(launch.id) ?? [];
+        list.push({ childId, state: subagent?.state });
+        claims.set(launch.id, list);
+      }
+    }
+    const entries: Array<AntigravityDetachedSubagentSyncEntry> = [];
+    for (const target of input.subagents) {
+      const matches = claims.get(target.nativeTaskId);
+      const match = matches?.length === 1 ? matches[0] : undefined;
+      if (match === undefined) continue;
+      const transcript = await readRawTranscript(
+        profileRoot,
+        { conversationId: match.childId },
+        TIMELINE_TRANSCRIPT_BYTE_CAP,
+      ).catch(() => undefined);
+      entries.push(
+        buildAntigravityChildTimeline({
+          target,
+          rootSessionId: input.rootSessionId,
+          childConversationId: match.childId,
+          rawSteps: transcript?.rawSteps ?? [],
+          truncated: transcript?.truncated ?? false,
+          parentNotice: inboxByChild.get(match.childId),
+          subagentState: match.state,
+        }),
+      );
+    }
+    return entries;
+  };
+  return yield* Effect.tryPromise({
+    try: read,
+    catch: (cause) => new AntigravityChildWorkReadError({ cause }),
+  }).pipe(Effect.orElseSucceed((): ReadonlyArray<AntigravityDetachedSubagentSyncEntry> => []));
+});
