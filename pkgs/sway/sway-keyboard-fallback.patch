+static struct wlr_keyboard *seat_find_fallback_keyboard(
+		struct sway_seat *sway_seat, struct sway_keyboard *excluding) {
+	struct sway_keyboard_group *group;
+	wl_list_for_each(group, &sway_seat->keyboard_groups, link) {
+		struct sway_keyboard *kb =
+			group->seat_device ? group->seat_device->keyboard : NULL;
+		if (kb && kb != excluding && kb->wlr && kb->wlr->keymap != NULL) {
+			return kb->wlr;
+		}
+	}
+
+	struct sway_seat_device *seat_device;
+	wl_list_for_each(seat_device, &sway_seat->devices, link) {
+		struct sway_keyboard *kb = seat_device->keyboard;
+		if (kb && kb != excluding && !seat_device->input_device->is_virtual &&
+				kb->wlr && kb->wlr->keymap != NULL) {
+			return kb->wlr;
+		}
+	}
+
+	wl_list_for_each(seat_device, &sway_seat->devices, link) {
+		struct sway_keyboard *kb = seat_device->keyboard;
+		if (kb && kb != excluding && kb->wlr && kb->wlr->keymap != NULL) {
+			return kb->wlr;
+		}
+	}
+
+	return NULL;
+}
