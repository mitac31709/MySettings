+// 本家 CandidateWindow.cpp (kMeaningMaxWidth = 320 DIP) に合わせ、意味・翻訳を狭い幅で折り返す
+std::string wrapMeaning(const std::string &text, size_t maxCols = 44) {
+    std::string out;
+    out.reserve(text.size() + 16);
+    size_t col = 0;
+    size_t lastSpaceOut = std::string::npos;
+    size_t i = 0;
+    while (i < text.size()) {
+        unsigned char c = static_cast<unsigned char>(text[i]);
+        if (c == '\r') {
+            i++;
+            continue;
+        }
+        if (c == '\n') {
+            out += '\n';
+            col = 0;
+            lastSpaceOut = std::string::npos;
+            i++;
+            continue;
+        }
+        size_t len = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+        len = std::min(len, text.size() - i);
+        size_t cols = len == 1 ? 1 : 2;
+        if (c == ' ' && col == 0) {
+            i += len;
+            continue;
+        }
+        if (col + cols > maxCols && col > 0) {
+            if (lastSpaceOut != std::string::npos && c != ' ') {
+                out[lastSpaceOut] = '\n';
+                col = 0;
+                for (size_t j = lastSpaceOut + 1; j < out.size();) {
+                    unsigned char uc = static_cast<unsigned char>(out[j]);
+                    size_t ulen = uc < 0x80 ? 1 : uc < 0xE0 ? 2 : uc < 0xF0 ? 3 : 4;
+                    ulen = std::min(ulen, out.size() - j);
+                    col += ulen == 1 ? 1 : 2;
+                    j += ulen;
+                }
+                lastSpaceOut = std::string::npos;
+            } else {
+                out += '\n';
+                col = 0;
+                lastSpaceOut = std::string::npos;
+                if (c == ' ') {
+                    i += len;
+                    continue;
+                }
+            }
+        }
+        if (c == ' ') lastSpaceOut = out.size();
+        out.append(text, i, len);
+        col += cols;
+        i += len;
+    }
+    return out;
+}
