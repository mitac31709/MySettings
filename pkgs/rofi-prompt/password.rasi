* {
  bg: #0b0f14;
  bg-alt: #111820;
  fg: #e6edf3;
  fg-dim: #6b7785;
  accent: #33c5c5;
  sel-bg: #15383a;
  border-subtle: #1f2a35;
  urgent: #e06c75;

  background-color: transparent;
  text-color: @fg;
  font: "JetBrainsMono Nerd Font 12";
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 0px;
  padding: 16px;
  width: 38em;
}

mainbox {
  children: [ message, inputbar, listview ];
  spacing: 12px;
}

message {
  background-color: @bg-alt;
  border: 1px;
  border-color: @border-subtle;
  border-radius: 0px;
  padding: 10px 12px;
}

textbox {
  text-color: @fg;
  vertical-align: 0.5;
}

inputbar {
  background-color: @bg-alt;
  border: 1px;
  border-color: @accent;
  border-radius: 0px;
  padding: 8px 12px;
  spacing: 10px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @accent;
}

entry {
  text-color: @fg;
  placeholder: "";
  placeholder-color: @fg-dim;
}

listview {
  enabled: false;
  lines: 2;
  fixed-height: false;
  spacing: 4px;
}

element {
  padding: 8px 12px;
  border: 1px;
  border-color: @border-subtle;
  border-radius: 0px;
}

element normal.normal {
  background-color: @bg-alt;
  text-color: @fg;
}

element selected.normal {
  background-color: @sel-bg;
  border-color: @accent;
  text-color: @fg;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}
