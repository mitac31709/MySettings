/* Unified Rofi password / confirmation prompt — Nocturne Slate theme. */
* {
  bg: #131922ea;
  bg-alt: #1a2330f0;
  fg: #e8eef5;
  fg-dim: #637286;
  accent: #56d4c8;
  sel-bg: #16333a;
  border-subtle: #263344;
  urgent: #f07178;

  background-color: transparent;
  text-color: @fg;
  font: "JetBrainsMono Nerd Font 12";
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 12px;
  padding: 20px;
  width: 40em;
}

mainbox {
  children: [ message, inputbar, listview ];
  spacing: 14px;
}

message {
  background-color: @bg-alt;
  border: 1px;
  border-color: @border-subtle;
  border-radius: 8px;
  padding: 12px 14px;
}

textbox {
  text-color: @fg;
  vertical-align: 0.5;
}

inputbar {
  background-color: @bg-alt;
  border: 1px;
  border-color: @accent;
  border-radius: 8px;
  padding: 10px 14px;
  spacing: 10px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @accent;
}

entry {
  text-color: @fg;
  placeholder: "入力してください…";
  placeholder-color: @fg-dim;
}

listview {
  enabled: false;
  lines: 2;
  fixed-height: false;
  spacing: 6px;
}

element {
  padding: 10px 14px;
  border: 1px;
  border-color: @border-subtle;
  border-radius: 8px;
}

element normal.normal {
  background-color: @bg-alt;
  text-color: @fg;
}

element selected.normal {
  background-color: @sel-bg;
  border-color: @accent;
  text-color: @accent;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}
